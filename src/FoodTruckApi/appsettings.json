{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "FoodTruckSearch": {
    "DefaultAmountOfResults": 10,
    "MaxAmountOfResults": 50
  },
